# Benchmark image: the tutorial image plus the spatial and modelling packages used by the manuscript benchmark
# (syntheticDataGIS/benchmark). Published as ohdsi/gaia-core-tutorial:benchmark; the tutorial itself uses :main.
# Build: docker build --platform linux/amd64 -f docker/gaia-core-tutorial/Dockerfile.benchmark -t ohdsi/gaia-core-tutorial:benchmark docker/gaia-core-tutorial
ARG BASE=ohdsi/gaia-core-tutorial:main
FROM ${BASE}

# system libraries for sf (GDAL, GEOS, PROJ, udunits)
RUN apt-get update \
 && apt-get install -y --no-install-recommends libgdal-dev libgeos-dev libproj-dev libudunits2-dev libsqlite3-dev \
 && rm -rf /var/lib/apt/lists/*

# sf: simple-features baseline join; sandwich, geepack, glmmTMB: cluster-robust, GEE and mixed models;
# blockCV: spatially blocked cross-validation (optional downstream model)
RUN Rscript -e "options(Ncpus = 2); install.packages(c('sf', 'sandwich', 'geepack', 'glmmTMB', 'blockCV'))"

# Build-time smoke test
RUN Rscript -e "for (p in c('sf', 'sandwich', 'geepack', 'glmmTMB', 'blockCV', 'lme4', 'CohortMethod', 'CaprForExtensions', 'FeatureExtractionForExtensions')) library(p, character.only = TRUE); stopifnot(nrow(sf::st_sf(a = 1, geometry = sf::st_sfc(sf::st_point(c(0, 0))))) == 1)"
